digraph {
  graph [rankdir=TB, splines=spline, nodesep=0.45, ranksep=0.7, bgcolor=white, fontname="Helvetica", pad=0.2];
  node  [shape=plain, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, color="#64748B", fontcolor="#7C2D12", penwidth=1.2, arrowsize=0.9];
  CUSTOMER [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>CUSTOMER</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_BUSINESS</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="national_code"><FONT COLOR="#1E3A8A">national_code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(10)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="mobile"><FONT COLOR="#1E3A8A">mobile</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(11)</FONT></TD><TD></TD></TR></TABLE>>];
  REQUEST [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>REQUEST</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_BUSINESS</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tracking_code"><FONT COLOR="#1E3A8A">tracking_code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT COLOR="#1E3A8A">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(32)</FONT></TD><TD></TD></TR></TABLE>>];
  OTP_CHALLENGE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>OTP_CHALLENGE</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_AUTH</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><FONT COLOR="#1E3A8A">customer_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="otp_id"><FONT COLOR="#1E3A8A">otp_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2  (Notifier sId)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="sms_id"><FONT COLOR="#1E3A8A">sms_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT COLOR="#1E3A8A">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">SENT | VERIFIED | EXPIRED</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="wrong_attempts"><FONT COLOR="#1E3A8A">wrong_attempts</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMBER(2)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="locked_until"><FONT COLOR="#1E3A8A">locked_until</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMP</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="sent_at"><FONT COLOR="#1E3A8A">sent_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMP</FONT></TD><TD></TD></TR></TABLE>>];
  REFRESH_TOKEN [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>REFRESH_TOKEN</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_AUTH</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#1E3A8A">user_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="user_type"><FONT COLOR="#1E3A8A">user_type</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">BANK | AGENCY</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="token_hash"><FONT COLOR="#1E3A8A">token_hash</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(64)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="family_id"><FONT COLOR="#1E3A8A">family_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at"><FONT COLOR="#1E3A8A">expires_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMP</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="used_at"><FONT COLOR="#1E3A8A">used_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMP</FONT></TD><TD></TD></TR></TABLE>>];
  JWT_BLACKLIST [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>JWT_BLACKLIST</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_AUTH</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="jti"><FONT COLOR="#1E3A8A">jti</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at"><FONT COLOR="#1E3A8A">expires_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMP</FONT></TD><TD></TD></TR></TABLE>>];
  OUTBOX_MESSAGE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>OUTBOX_MESSAGE</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_OUTBOX</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="request_id"><FONT COLOR="#1E3A8A">request_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event"><FONT COLOR="#1E3A8A">event</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2  (SMS 1..8)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="number"><FONT COLOR="#1E3A8A">number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(13)  0989…</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="message"><FONT COLOR="#1E3A8A">message</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(1000)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT COLOR="#1E3A8A">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PENDING | SENT | DEAD_LETTER</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="attempts"><FONT COLOR="#1E3A8A">attempts</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMBER(3)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="next_attempt_at"><FONT COLOR="#1E3A8A">next_attempt_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMP</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="sms_id"><FONT COLOR="#1E3A8A">sms_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR></TABLE>>];
  AUDIT_LOG [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>AUDIT_LOG</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_AUDIT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id / user_role"><FONT COLOR="#1E3A8A">user_id / user_role</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16) / VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="entity_type"><FONT COLOR="#1E3A8A">entity_type</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="entity_id"><FONT COLOR="#1E3A8A">entity_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="action"><FONT COLOR="#1E3A8A">action</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="old_value / new_value"><FONT COLOR="#1E3A8A">old_value / new_value</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">CLOB (JSON)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="ip_address / user_agent"><FONT COLOR="#1E3A8A">ip_address / user_agent</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#1E3A8A">created_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMP</FONT></TD><TD></TD></TR></TABLE>>];
  TRACKING_COUNTER [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>TRACKING_COUNTER</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_BUSINESS</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="branch_code"><FONT COLOR="#1E3A8A">branch_code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(10)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="agency_code"><FONT COLOR="#1E3A8A">agency_code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(4)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="day"><FONT COLOR="#1E3A8A">day</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(6)  YYMMDD</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_value"><FONT COLOR="#1E3A8A">last_value</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMBER(4)</FONT></TD><TD></TD></TR></TABLE>>];
  SCHEDULER_LOCK [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>SCHEDULER_LOCK</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_BUSINESS</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="job_name"><FONT COLOR="#1E3A8A">job_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="locked_by"><FONT COLOR="#1E3A8A">locked_by</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="locked_until"><FONT COLOR="#1E3A8A">locked_until</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMP</FONT></TD><TD></TD></TR></TABLE>>];
  {rank=same; CUSTOMER; REQUEST; AUDIT_LOG;}
  {rank=same; OTP_CHALLENGE; OUTBOX_MESSAGE; REFRESH_TOKEN;}
  {rank=same; JWT_BLACKLIST; TRACKING_COUNTER; SCHEDULER_LOCK;}
  AUDIT_LOG -> REFRESH_TOKEN [style=invis]; REFRESH_TOKEN -> JWT_BLACKLIST [style=invis]; OTP_CHALLENGE -> TRACKING_COUNTER [style=invis]; OUTBOX_MESSAGE -> SCHEDULER_LOCK [style=invis];
  CUSTOMER -> OTP_CHALLENGE [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both];
  REQUEST -> OUTBOX_MESSAGE [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both];
  AUDIT_LOG -> REQUEST [label="entity_id (logical, no FK)", style=dashed, arrowhead=none, arrowtail=none, dir=both, constraint=false];
}
