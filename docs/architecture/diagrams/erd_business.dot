digraph {
  graph [rankdir=TB, splines=spline, nodesep=0.45, ranksep=0.7, bgcolor=white, fontname="Helvetica", pad=0.2];
  node  [shape=plain, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, color="#64748B", fontcolor="#7C2D12", penwidth=1.2, arrowsize=0.9];
  CUSTOMER [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>CUSTOMER</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_BUSINESS</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cif"><FONT COLOR="#1E3A8A">cif</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="national_code"><FONT COLOR="#1E3A8A">national_code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(10)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name"><FONT COLOR="#1E3A8A">first_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name"><FONT COLOR="#1E3A8A">last_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="father_name"><FONT COLOR="#1E3A8A">father_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="birth_date"><FONT COLOR="#1E3A8A">birth_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">DATE</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="mobile"><FONT COLOR="#1E3A8A">mobile</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(11)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="ssn"><FONT COLOR="#1E3A8A">ssn</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="id_series / id_serial"><FONT COLOR="#1E3A8A">id_series / id_serial</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="personality_type"><FONT COLOR="#1E3A8A">personality_type</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="gender"><FONT COLOR="#1E3A8A">gender</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR></TABLE>>];
  AGENCY [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>AGENCY</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_BUSINESS</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cif"><FONT COLOR="#1E3A8A">cif</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code"><FONT COLOR="#1E3A8A">code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(4)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT COLOR="#1E3A8A">name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="active"><FONT COLOR="#1E3A8A">active</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMBER(1)</FONT></TD><TD></TD></TR></TABLE>>];
  BRANCH [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>BRANCH</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_BUSINESS</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="branch_code"><FONT COLOR="#1E3A8A">branch_code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(10)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT COLOR="#1E3A8A">name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="city"><FONT COLOR="#1E3A8A">city</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="address / tel / fax / zip"><FONT COLOR="#1E3A8A">address / tel / fax / zip</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="parent_branch"><FONT COLOR="#1E3A8A">parent_branch</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(10)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="active"><FONT COLOR="#1E3A8A">active</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMBER(1)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="last_synced_at"><FONT COLOR="#1E3A8A">last_synced_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMP</FONT></TD><TD></TD></TR></TABLE>>];
  REJECTION_REASON [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>REJECTION_REASON</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_BUSINESS</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT COLOR="#1E3A8A">kind</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">ISSUANCE | REVOCATION</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="text"><FONT COLOR="#1E3A8A">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="active"><FONT COLOR="#1E3A8A">active</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMBER(1)</FONT></TD><TD></TD></TR></TABLE>>];
  APP_USER [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>APP_USER</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_AUTH</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="account_name"><FONT COLOR="#1E3A8A">account_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prsn_code"><FONT COLOR="#1E3A8A">prsn_code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="branch_code"><FONT COLOR="#1E3A8A">branch_code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(10)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="position / job"><FONT COLOR="#1E3A8A">position / job</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="role"><FONT COLOR="#1E3A8A">role</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">BRANCH | ADMIN</FONT></TD><TD></TD></TR></TABLE>>];
  REQUEST [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>REQUEST</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_BUSINESS</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tracking_code"><FONT COLOR="#1E3A8A">tracking_code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="request_type"><FONT COLOR="#1E3A8A">request_type</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">ISSUANCE | REVOCATION</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="parent_request_id"><FONT COLOR="#1E3A8A">parent_request_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><FONT COLOR="#1E3A8A">customer_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="agency_id"><FONT COLOR="#1E3A8A">agency_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="branch_code"><FONT COLOR="#1E3A8A">branch_code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(10)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amount"><FONT COLOR="#1E3A8A">amount</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMBER(18)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="expiry_date"><FONT COLOR="#1E3A8A">expiry_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">DATE</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT COLOR="#1E3A8A">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(32)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="guarantee_number"><FONT COLOR="#1E3A8A">guarantee_number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(30)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="rejection_reason_id"><FONT COLOR="#1E3A8A">rejection_reason_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rejection_comment"><FONT COLOR="#1E3A8A">rejection_comment</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(500)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="locked_by / locked_by_name"><FONT COLOR="#1E3A8A">locked_by / locked_by_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16) / VARCHAR2</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="locked_at / last_activity_at"><FONT COLOR="#1E3A8A">locked_at / last_activity_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMP</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="version"><FONT COLOR="#1E3A8A">version</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMBER(10)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="registered_at … revoked_at"><FONT COLOR="#1E3A8A">registered_at … revoked_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMP</FONT></TD><TD></TD></TR></TABLE>>];
  COMPANION [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>COMPANION</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_BUSINESS</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="request_id"><FONT COLOR="#1E3A8A">request_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="national_code"><FONT COLOR="#1E3A8A">national_code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2(10)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name / last_name"><FONT COLOR="#1E3A8A">first_name / last_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="relation"><FONT COLOR="#1E3A8A">relation</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR></TABLE>>];
  COLLATERAL [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>COLLATERAL</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_BUSINESS</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="request_id"><FONT COLOR="#1E3A8A">request_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT COLOR="#1E3A8A">kind</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">CASH | PLEDGE</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="deposit_number"><FONT COLOR="#1E3A8A">deposit_number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="deposit_class"><FONT COLOR="#1E3A8A">deposit_class</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">CHEAP | EXPENSIVE</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="share_percent"><FONT COLOR="#1E3A8A">share_percent</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMBER(3)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="factor"><FONT COLOR="#1E3A8A">factor</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMBER(3,2)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="allocated_amount"><FONT COLOR="#1E3A8A">allocated_amount</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMBER(18)</FONT></TD><TD></TD></TR></TABLE>>];
  INQUIRY [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#93B4E8"><TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="white"><B>INQUIRY</B></FONT>  <FONT COLOR="#BFDBFE" POINT-SIZE="9">AZS_INQUIRY</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#1E3A8A">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="request_id"><FONT COLOR="#1E3A8A">request_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="run_id"><FONT COLOR="#1E3A8A">run_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">RAW(16)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="inquiry_type"><FONT COLOR="#1E3A8A">inquiry_type</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="attempt_no"><FONT COLOR="#1E3A8A">attempt_no</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMBER(2)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="result"><FONT COLOR="#1E3A8A">result</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PASSED | NEGATIVE | FAILED | SKIPPED</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="failure_kind"><FONT COLOR="#1E3A8A">failure_kind</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="response_code / duration_ms"><FONT COLOR="#1E3A8A">response_code / duration_ms</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2 / NUMBER</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="provider_trace_id"><FONT COLOR="#1E3A8A">provider_trace_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR2</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="raw_response"><FONT COLOR="#1E3A8A">raw_response</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">CLOB</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="executed_at"><FONT COLOR="#1E3A8A">executed_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMP</FONT></TD><TD></TD></TR></TABLE>>];
  {rank=same; CUSTOMER; AGENCY; BRANCH; REJECTION_REASON; APP_USER;}
  {rank=same; COMPANION; COLLATERAL; INQUIRY;}
  CUSTOMER -> REQUEST [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both];
  AGENCY -> REQUEST [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both];
  BRANCH -> REQUEST [label="1 : N  (original branch)", arrowhead=crow, arrowtail=tee, dir=both];
  REJECTION_REASON -> REQUEST [label="0..1 : N", arrowhead=crowodot, arrowtail=tee, dir=both];
  APP_USER -> REQUEST [label="locked_by  0..1 : N", arrowhead=crowodot, arrowtail=tee, dir=both];
  BRANCH -> BRANCH [label="parent_branch\n(self or replacement)", arrowhead=teeodot, arrowtail=tee, dir=both];
  REQUEST -> REQUEST [label="parent_request_id\n(revocation → issuance)", arrowhead=teeodot, arrowtail=tee, dir=both];
  REQUEST -> COMPANION [label="1 : 0..5", arrowhead=crow, arrowtail=tee, dir=both];
  REQUEST -> COLLATERAL [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both];
  REQUEST -> INQUIRY [label="1 : N  (per attempt)", arrowhead=crow, arrowtail=tee, dir=both];
}
