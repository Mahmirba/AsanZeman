# systemd unit for one application VM (D55). Copy to /etc/systemd/system/asanzeman.service, then:
#   systemctl daemon-reload && systemctl enable --now asanzeman
#
# Assumes a Linux VM with a Java 26 runtime at /usr/bin/java. For another operating system, run the same command line under
# that system's service manager; see docs/runbook.md.
[Unit]
Description=Asan Zeman backend
After=network-online.target
Wants=network-online.target

[Service]
User=asanzeman
Group=asanzeman
WorkingDirectory=/opt/asanzeman

# JAVA_OPTS (heap size and so on) are optional and kept in the second file, so a size change needs no edit of this unit
EnvironmentFile=-/etc/asanzeman/java.env
ExecStart=/usr/bin/java $JAVA_OPTS --enable-preview -jar /opt/asanzeman/asanzeman.jar \
    --spring.config.additional-location=file:/etc/asanzeman/application.properties

# Spring's graceful shutdown lets requests in flight finish (server.shutdown=graceful); 143 is the JVM's normal exit on SIGTERM
SuccessExitStatus=143
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

# the service writes nothing to disk: logs go to the journal, state to Oracle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
